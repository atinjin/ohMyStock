# OhMyStock 자격증명 템플릿 — .env 로 복사해 값을 채우세요. (.env 는 git 제외됨)
#   cp .env.example .env   그리고 아래 값 입력
# 스모크 스크립트가 .env 를 자동 로드합니다:
#   uv run python scripts/kis_smoke.py        # 토큰+잔고+보유(읽기 전용, 안전)
#   uv run python scripts/toss_smoke.py       # 토큰+계좌+보유(읽기 전용, 안전)

# ── 한국투자증권(KIS) ─────────────────────────────────────────────
# 발급: https://apiportal.koreainvestment.com  (앱키/앱시크릿 + 모의투자 계좌 신청)
# 계좌번호는 "12345678-01" 형식(종합계좌-상품코드).
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# KIS 기본은 모의투자(가짜 돈). 실전(실제 돈)으로 쓰려면 아래를 0 으로:
# OHMYSTOCK_KIS_PAPER=0

# ── 토스증권(TOSS Invest) ─────────────────────────────────────────
# 발급: https://developers.tossinvest.com  (OAuth2 client_credentials)
# 주의: TOSS는 모의투자(샌드박스)가 없어 모든 주문이 실거래.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# accountSeq 는 보통 자동 해석. 특정 계좌를 쓰려면 지정:
# TOSS_ACCOUNT_SEQ=

# ── Alpaca (US, 선택) ─────────────────────────────────────────────
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# 기본은 페이퍼 엔드포인트(가짜 돈). 라이브는 ALPACA_BASE_URL 명시 + 아래 동의.
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── 실제 돈 동의 게이트 ───────────────────────────────────────────
# TOSS·KIS 실전·Alpaca 라이브로 실주문하려면 명시적으로 동의(1/true/yes):
# OHMYSTOCK_ALLOW_REAL_MONEY=1
